cabal-version: 2.4
name:          tidal-oracle
version:       0.1.0
synopsis:      Prints real Tidal's events for Undertow's conformance cases
build-type:    Simple

executable tidal-oracle
  main-is:          Main.hs
  other-modules:    Cases
  build-depends:    base, tidal ==1.10.*
  default-language: Haskell2010
  ghc-options:      -Wall
